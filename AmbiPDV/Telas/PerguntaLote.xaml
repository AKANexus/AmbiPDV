<Window x:Class="PDV_WPF.Telas.PerguntaLote"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PDV_WPF.Telas"
        mc:Ignorable="d"
        Height="283" Width="500" KeyDown="PerguntaLote_KeyDown" WindowStartupLocation="CenterScreen" Background="{x:Null}" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="True" AllowsTransparency="True">
    <Border Background="#FFF9F9F9" CornerRadius="10" Margin="10">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="1.5" Opacity="0.65" Direction="300" BlurRadius="8"/>
        </Border.Effect>
        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Label Content="DIGITE O NÚMERO DO LOTE" HorizontalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,0" FontFamily="Open Sans SemiBold" FontSize="24"  FontStyle="Italic" Foreground="#FF757575"/>
            <Label x:Name="lbl_descricao" Content="DESCRIÇÃO DO ITEM SELECIONADO" HorizontalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" VerticalAlignment="Center" Margin="0,-5,0,15" FontFamily="Open Sans SemiBold" FontSize="12" FontStyle="Italic" Foreground="#FF757575"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Background="#FF09CAAA" Margin="0,0,-1,0" Panel.ZIndex="1" >
                    <Label Content="Ï" VerticalAlignment="Center" VerticalContentAlignment="Center" Foreground="#FFFEFEFE" FontFamily="Webdings" FontSize="37"/>
                </Border>
                <TextBox x:Name="txb_Lote" Width="305" VerticalContentAlignment="Center" VerticalAlignment="Center" FontFamily="Open Sans" FontSize="28" Padding="3" HorizontalContentAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="txb_aviso" Visibility="Collapsed" Foreground="Red" HorizontalAlignment="Center" Margin="0,15,0,0"><Run Text="QUANTIDADE NECESSÁRIA RESTANTE: "/><Run x:Name="txb_qtdRestante" FontWeight="Bold" FontSize="15"/></TextBlock>
        </StackPanel>
    </Border>
</Window>